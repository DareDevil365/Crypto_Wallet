# Copy to .env and fill in for testnet deploy
# For local demo, none of these are needed

# Base Sepolia deploy (optional - only needed for testnet)
PRIVATE_KEY=0xabc123...your_throwaway_deployer_key

# Public RPC (free, no signup)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block explorer verification (optional)
BASESCAN_API_KEY=your_basescan_api_key
